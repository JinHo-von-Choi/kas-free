# ========================================
# Chrome Extension — 배포 필수 파일만 커밋
# ========================================
#
# 전략: 모든 파일을 기본적으로 제외하고
#       배포 및 개발에 필요한 파일만 포함
#
# 작성자: 최진호
# 작성일: 2026-02-14

# 1단계: 모든 파일 제외
*

# 2단계: 필수 파일 포함

# 메타데이터
!manifest.json
!README.md
!CHANGELOG.md

# 아이콘
!icon16.png
!icon48.png
!icon128.png
!icons/
!icons/**

# 소스 코드
!src/
!src/**

# 다국어
!_locales/
!_locales/**

# 개발 도구
!tests/
!tests/**
!package.json
!babel.config.json
!jest.e2e.config.js

# Git 설정
!.gitignore

# 3단계: 자동 생성/재생성 파일 명시적 제외
docs/
CLAUDE.md
AGENTS.md
DC_HTML_STRUCTURE.md
IMPROVEMENT_PLAN.md
USER_GUIDE.md
*.log
node_modules/
package-lock.json
models/
kas-free-v*.zip
placeholder.jpg
.vscode/
.idea/
.DS_Store
Thumbs.db

# 4단계: 로컬 전용 파일 재제외
src/**/*.local.json
src/**/*.local.js
src/**/config.local.*
src/**/*.tmp
src/**/*.temp
src/**/*.backup
src/**/*.bak
src/**/test_*
src/**/*_test.js
src/**/*.test.js
src/**/*.spec.js
