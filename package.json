{
  "name": "kas-free",
  "version": "1.3.0",
  "description": "카-스 프리 Chrome 확장 프로그램",
  "author": "최진호",
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.test.js",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@types/chrome": "^0.0.268",
    "@types/jest": "30.0.0",
    "babel-jest": "30.5.2",
    "cross-env": "^10.1.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "puppeteer": "25.13.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "./tests/setup.js"
    ],
    "testMatch": [
      "**/tests/unit/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/memen/"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/lib/**",
      "!src/offscreen/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "engines": {
    "node": ">=22"
  }
}
